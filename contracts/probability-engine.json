{
  "contractVersion": 1,
  "description": "现有 Java 与 Python 概率引擎的兼容契约；迁移不改变统计参数。",
  "module": "engine.cli",
  "commands": ["daily", "prepare", "train", "predict", "walkforward", "settle", "evaluate", "backtest", "status", "config"],
  "javaCommands": {"DAILY": "daily", "PREPARE": "prepare", "TRAIN": "train", "PREDICT": "predict", "WALKFORWARD": "walkforward", "SETTLE": "settle", "EVALUATE": "evaluate", "BACKTEST": "backtest"},
  "options": ["--asof", "--limit-stocks", "--run-id", "--force", "--no-resume", "--fast"],
  "environment": {
    "PROB_CONFIG": "与 Java config-path 同源；显式 CLI --config 优先，必须位于子命令之前。",
    "PROB_FEATURES": "与 Java features-path 同源；未设置时读取引擎根 features.yaml。",
    "PROB_DB_URL": "仅进程环境传入，不在公开快照、命令参数和日志中输出凭据。",
    "PROB_RUNTIME_ROOT": "仅解析相对产物、日志、断点路径，不进入 cfg 或 model_version。"
  },
  "source": {"table": "stock_daily_all", "adjustflag": 2, "prefixes": ["00", "60", "30"], "etfPrefixExcluded": "58"},
  "statistics": {"lookback_days": 500, "min_history": 250, "horizons": [1, 3, 5, 10], "n_paths": 10000, "seed_base": 20260101, "oos_fast": true, "oos_max_days": 40, "oos_stride": 5, "oos_max_stocks": 300},
  "predictionPrimaryKey": ["code", "market", "asof_date", "horizon", "pred_type", "model_version"],
  "runTerminalStatuses": ["SUCCESS", "FAILED"],
  "oosUsableStatuses": ["PENDING", "SETTLED"],
  "oosConsumerStatus": "SETTLED",
  "excludedStatus": "EXCLUDED",
  "checkpointSchema": 3,
  "verificationDatabase": "stock_platform_verify",
  "numericTolerance": {"absolute": 1e-8, "relative": 1e-7, "persistedDecimalAbsolute": 1e-6},
  "toleranceNote": "离线固定输入样本按严格浮点容差比较；离散键、股票池、计数与标签必须完全一致。跨环境完整训练另行测量自身基线差异，不能据此承诺逐位一致。"
}
